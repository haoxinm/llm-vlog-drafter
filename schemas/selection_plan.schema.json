{
  "$defs": {
    "SelectionClip": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "enum": [
            "start",
            "center",
            "end",
            "best"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "audio_policy": {
          "enum": [
            "natural_sound",
            "ambient_low",
            "muted"
          ],
          "title": "Audio Policy",
          "type": "string"
        },
        "clip_instance_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Clip Instance Id",
          "type": "string"
        },
        "intentional_repeat_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intentional Repeat Reason"
        },
        "moment_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Moment Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "title": "Rationale",
          "type": "string"
        },
        "target_duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Target Duration Seconds",
          "type": "number"
        },
        "track_role": {
          "enum": [
            "primary_video",
            "overlay",
            "natural_audio",
            "music",
            "narration"
          ],
          "title": "Track Role",
          "type": "string"
        },
        "transition_in": {
          "$ref": "#/$defs/SelectionTransition"
        }
      },
      "required": [
        "clip_instance_id",
        "moment_id",
        "target_duration_seconds",
        "anchor",
        "track_role",
        "audio_policy",
        "transition_in",
        "rationale"
      ],
      "title": "SelectionClip",
      "type": "object"
    },
    "SelectionScene": {
      "additionalProperties": false,
      "properties": {
        "clips": {
          "items": {
            "$ref": "#/$defs/SelectionClip"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Clips",
          "type": "array"
        },
        "purpose": {
          "maxLength": 500,
          "title": "Purpose",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Scene Id",
          "type": "string"
        },
        "target_duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 7200,
          "title": "Target Duration Seconds",
          "type": "number"
        },
        "title": {
          "maxLength": 200,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "title",
        "purpose",
        "target_duration_seconds",
        "clips"
      ],
      "title": "SelectionScene",
      "type": "object"
    },
    "SelectionTitle": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Duration Seconds",
          "type": "number"
        },
        "rationale": {
          "default": "",
          "maxLength": 500,
          "title": "Rationale",
          "type": "string"
        },
        "role": {
          "enum": [
            "opening_title",
            "scene_title",
            "closing"
          ],
          "title": "Role",
          "type": "string"
        },
        "scene_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Scene Id",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/TitleStart"
        },
        "style": {
          "const": "simple",
          "default": "simple",
          "title": "Style",
          "type": "string"
        },
        "text": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_source": {
          "enum": [
            "project_title",
            "outline_scene_title",
            "user_config",
            "folder_name",
            "user"
          ],
          "title": "Text Source",
          "type": "string"
        },
        "title_id": {
          "pattern": "^[A-Za-z0-9_.-]{1,80}$",
          "title": "Title Id",
          "type": "string"
        },
        "track": {
          "const": "V2",
          "default": "V2",
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "title_id",
        "text",
        "role",
        "scene_id",
        "text_source",
        "start",
        "duration_seconds"
      ],
      "title": "SelectionTitle",
      "type": "object"
    },
    "SelectionTransition": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "maximum": 5,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "type": {
          "enum": [
            "cut",
            "dissolve"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "duration_seconds"
      ],
      "title": "SelectionTransition",
      "type": "object"
    },
    "TitleStart": {
      "additionalProperties": false,
      "description": "Where a title starts, relative to the plan (code turns it into a frame): `scene_start` / `clip_start` + offset, or\n`sequence_end` (the title ends `offset` seconds before the end of the sequence).",
      "properties": {
        "clip_instance_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Instance Id"
        },
        "offset_seconds": {
          "default": 0.0,
          "maximum": 3600,
          "minimum": 0,
          "title": "Offset Seconds",
          "type": "number"
        },
        "relative_to": {
          "enum": [
            "scene_start",
            "clip_start",
            "sequence_end"
          ],
          "title": "Relative To",
          "type": "string"
        }
      },
      "required": [
        "relative_to"
      ],
      "title": "TitleStart",
      "type": "object"
    }
  },
  "$id": "urn:trip-vlog:schema:selection_plan:1.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "LLM-facing selection plan: moment IDs, target durations, anchors. No source timestamps.",
  "properties": {
    "planner": {
      "pattern": "^[A-Za-z0-9_.-]{1,40}$",
      "title": "Planner",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SelectionScene"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "titles": {
      "items": {
        "$ref": "#/$defs/SelectionTitle"
      },
      "maxItems": 50,
      "title": "Titles",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "planner",
    "scenes",
    "uncertainties"
  ],
  "title": "SelectionPlan",
  "type": "object"
}
